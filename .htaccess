Options -Indexes
DirectoryIndex index.html

<IfModule mod_headers.c>
  <FilesMatch "^(index\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(?:css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:webp|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One canonical host: send www traffic to the bare domain.
  RewriteCond %{HTTP_HOST} ^www\.rahimfabrics\.site$ [NC]
  RewriteRule ^ https://rahimfabrics.site%{REQUEST_URI} [R=301,L,NE]

  # Preserve the established canonical URL for the Boski product.
  RewriteRule ^products/two-horse-boski-by-shahji-fabrics/?$ /products/two-horse-boski-by-rahim-fabrics [R=301,L,NE]

  # When the Git repository itself is deployed, keep source-only folders private.
  RewriteRule ^(?:client|database|facebook-page-assets|node_modules)(?:/|$) - [F,L,NC]

  # Preserve the Authorization header for PHP bearer-token authentication.
  RewriteCond %{HTTP:Authorization} ^(.+)$
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

  # Uploads are stored above public_html so deployments keep them; serve them from there.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^uploads/(products|payment-slips)/([A-Za-z0-9_-]+\.[a-z]+)$ media.php?kind=$1&file=$2 [L,QSA]

  # Send API routes to the PHP front controller unless a real API file exists.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api(?:/.*)?$ api/index.php [QSA,L]

  # Generate the sitemap from the current product catalogue.
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # Google Merchant Center compatible product feed.
  RewriteRule ^merchant-feed\.xml$ merchant-feed.php [L]

  # React Router fallback with route-specific SEO metadata and status codes.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . seo.php [L]
</IfModule>

<FilesMatch "^(?:package(?:-lock)?\.json|README\.md|\.gitignore)$">
  Require all denied
</FilesMatch>
