Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # When the Git repository itself is deployed, keep source-only folders private.
  RewriteRule ^(?:client|database|facebook-page-assets|node_modules)(?:/|$) - [F,L,NC]

  # Preserve the Authorization header for PHP bearer-token authentication.
  RewriteCond %{HTTP:Authorization} ^(.+)$
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

  # Send API routes to the PHP front controller unless a real API file exists.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api(?:/.*)?$ api/index.php [QSA,L]

  # Generate the sitemap from the current product catalogue.
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # React Router fallback with route-specific SEO metadata and status codes.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . seo.php [L]
</IfModule>

<FilesMatch "^(?:package(?:-lock)?\.json|README\.md|\.gitignore)$">
  Require all denied
</FilesMatch>
