{
  "name": "rahim-fabrics",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c green,yellow \"npm --prefix client run dev\" \"npm --prefix server run dev\"",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "install:all": "npm install"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
